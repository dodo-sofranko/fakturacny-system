# Databáza
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fakturacia
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Aplikácia
APP_NAME=Fakturácia
APP_URL=http://fakturacia.localhost
BASE_PATH=
APP_DEBUG=false
APP_SECRET=zmen-na-dlhy-nahodny-retazec-aspon-32-znakov

# E-faktúry cez Peppol (SAPI-SK API digitálneho poštára). Prázdne = tlačidlo „Odoslať“ sa nezobrazí.
# Test bez registrácie (Verteco sandbox – validuje, nič nedoručí): URL https://peppol.verteco.digital/sapi, ID aj secret = sandbox
PEPPOL_API_URL=
PEPPOL_CLIENT_ID=
PEPPOL_CLIENT_SECRET=

# JSON API /api/v1 – sha256 hash tokenu (hex). Prázdne = API vypnuté.
# Hash: printf %s "$TOKEN" | shasum -a 256
API_TOKEN_HASH=
